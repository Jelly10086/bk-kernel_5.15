#!/system/bin/sh
set -eu
umask 077
MODDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
STATE=/data/adb/bkk-control
BB=/data/adb/ksu/bin/busybox
REQUEST=/sys/kernel/bkk_control/request
STATUS=/sys/kernel/bkk_control/status
CONFIG=$STATE/control.conf
LOG=$STATE/control.log

die() { echo "[ERROR] $*" >&2; exit 1; }
log() {
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 65536 ]; then
        mv -f "$LOG" "$LOG.1"
    fi
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}
read_mode() {
    MODE=$(sed -n 's/^mode=//p' "$CONFIG" 2>/dev/null || true)
    case "$MODE" in disabled|auto|manual) ;; *) MODE=disabled ;; esac
}
set_mode() {
    printf 'mode=%s\n' "$1" > "$CONFIG.tmp"
    mv -f "$CONFIG.tmp" "$CONFIG"
}
off() {
    if [ -w "$REQUEST" ]; then
        printf 'off\n' > "$REQUEST" || return 1
    fi
}
running() {
    [ -r "$STATE/daemon.pid" ] || return 1
    IFS= read -r DAEMON_PID < "$STATE/daemon.pid"
    case "$DAEMON_PID" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$DAEMON_PID/cmdline" ] || return 1
    case "$(tr '\000' ' ' < "/proc/$DAEMON_PID/cmdline")" in
        *"$MODDIR/bkctl daemon"*) return 0 ;;
    esac
    return 1
}
ensure_lkm() {
    [ "$(getprop ro.product.device)" = sheng ] || die '仅支持sheng'
    [ "$(getprop ro.soc.model)" = SM8550 ] || die 'CPU配置不匹配'
    BUILT_RELEASE=$(sed -n 's/^KERNEL_RELEASE=//p' "$MODDIR/build-info.txt")
    [ "$(uname -r)" = "$BUILT_RELEASE" ] || die '请安装与当前内核配套的bkk-control'
    BUILT_SOURCE=$(sed -n 's/^MODULE_SRCVERSION=//p' "$MODDIR/build-info.txt")
    [ -n "$BUILT_SOURCE" ] || die 'LKM来源信息缺失'
    if [ -e "$REQUEST" ] && [ "$(cat /sys/module/bkk_perf/srcversion)" != "$BUILT_SOURCE" ]; then
        off || die '旧LKM停止失败'
        rmmod bkk_perf || die '旧LKM卸载失败'
    fi
    if [ ! -e "$REQUEST" ]; then
        insmod "$MODDIR/bkk_perf.ko" || die 'bkk_perf.ko加载失败'
    fi
    BUILT_REVISION=$(sed -n 's/^version=//p' "$MODDIR/module.prop")
    [ "$(sed -n 's/^version=//p' "$STATUS")" = "$BUILT_REVISION" ] || die '已加载LKM版本不匹配'
}
find_sensors() {
    BATTERY_ZONES=
    CPU_ZONES=
    for ZONE in /sys/class/thermal/thermal_zone*; do
        [ -r "$ZONE/type" ] || continue
        TYPE=$(cat "$ZONE/type")
        case "$TYPE" in
            battery|batt_therm) BATTERY_ZONES="$BATTERY_ZONES $ZONE/temp" ;;
            cpuss-*|cpu-*-*) CPU_ZONES="$CPU_ZONES $ZONE/temp" ;;
        esac
    done
    [ -n "$BATTERY_ZONES" ] && [ -n "$CPU_ZONES" ]
}
max_temperature() {
    MAX_TEMP=-1
    for NODE in "$@"; do
        TEMP=$(cat "$NODE" 2>/dev/null) || return 1
        case "$TEMP" in ''|*[!0-9]*) return 1 ;; esac
        [ "$TEMP" -ge 1000 ] && [ "$TEMP" -le 150000 ] || return 1
        [ "$TEMP" -le "$MAX_TEMP" ] || MAX_TEMP=$TEMP
    done
    [ "$MAX_TEMP" -ge 0 ] || return 1
    printf '%s\n' "$MAX_TEMP"
}
start_daemon() {
    "$BB" flock 9
    if running; then
        "$BB" flock -u 9
        return 0
    fi
    "$BB" setsid "$BB" sh "$MODDIR/bkctl" daemon </dev/null >/dev/null 2>&1 &
    ATTEMPTS=0
    while [ "$ATTEMPTS" -lt 20 ]; do
        if running; then
            "$BB" flock -u 9
            return 0
        fi
        ATTEMPTS=$((ATTEMPTS + 1))
        sleep 0.1
    done
    "$BB" flock -u 9
    die '控制服务未启动，提升请求将超时撤销'
}
daemon() {
    exec 8>"$STATE/daemon.lock"
    "$BB" flock 8
    printf '%s\n' "$$" > "$STATE/daemon.pid"
    finish() {
        trap - EXIT INT TERM
        "$BB" flock 9
        off || true
        if [ "$(cat "$STATE/daemon.pid" 2>/dev/null)" = "$$" ]; then
            rm -f "$STATE/daemon.pid"
        fi
        "$BB" flock -u 9
    }
    trap finish EXIT
    trap 'exit 0' INT TERM
    find_sensors || die '温度传感器不完整'
    LAST_STATE=
    while :; do
        "$BB" flock 9
        read_mode
        if [ "$MODE" = disabled ] || [ -e "$MODDIR/disable" ] || [ -e "$MODDIR/remove" ]; then
            finish
            break
        fi
        # Sensor failure withdraws the lease instead of reusing old temperatures.
        BATTERY=$(max_temperature $BATTERY_ZONES) || BATTERY=
        SOC=$(max_temperature $CPU_ZONES) || SOC=
        BRIGHTNESS=$(cat /sys/class/backlight/panel0-backlight/brightness 2>/dev/null) || BRIGHTNESS=
        case "$BRIGHTNESS" in ''|*[!0-9]*) SCREEN=unknown ;; 0) SCREEN=0 ;; *) SCREEN=1 ;; esac
        if [ -z "$BATTERY" ] || [ -z "$SOC" ] || [ "$SCREEN" = unknown ]; then
            off
            CURRENT_STATE=sensor_error
        else
            if ! printf '%s %s %s %s\n' "$MODE" "$BATTERY" "$SOC" "$SCREEN" > "$REQUEST"; then
                off
                CURRENT_STATE=request_failed
                set_mode disabled
            else
                CURRENT_STATE=$(sed -n 's/^state=//p' "$STATUS")
            fi
        fi
        if [ "$CURRENT_STATE" != "$LAST_STATE" ]; then
            log "mode=$MODE state=$CURRENT_STATE battery_mC=$BATTERY soc_mC=$SOC"
            LAST_STATE=$CURRENT_STATE
        fi
        "$BB" flock -u 9
        sleep 3
    done
}

get_all() {
    "$BB" flock 9
    read_mode
    CURRENT_KERNEL=$(uname -r)
    TARGET_KERNEL=$(sed -n 's/^KERNEL_RELEASE=//p' "$MODDIR/build-info.txt")
    COMPATIBLE=0
    RUNTIME=waiting_kernel
    if [ -n "$TARGET_KERNEL" ] && [ "$CURRENT_KERNEL" = "$TARGET_KERNEL" ]; then
        COMPATIBLE=1
        RUNTIME=disabled
        if [ "$MODE" != disabled ]; then
            SNAPSHOT=$(cat "$STATUS" 2>/dev/null || true)
            RUNTIME=$(printf '%s\n' "$SNAPSHOT" | sed -n 's/^state=//p')
            APPLIED_MODE=$(printf '%s\n' "$SNAPSHOT" | sed -n 's/^mode=//p')
            case "$MODE" in auto) EXPECTED_MODE=1 ;; manual) EXPECTED_MODE=2 ;; esac
            case "$RUNTIME" in
                boost|idle|disabled)
                    if [ "$APPLIED_MODE" != "$EXPECTED_MODE" ]; then
                        RUNTIME=pending
                    elif [ "$RUNTIME" = boost ]; then
                        # 切换模式会先撤销旧投票，只有频率下限生效才显示提升
                        HAS_FLOOR=$(printf '%s\n' "$SNAPSHOT" | awk -F= '/^cluster[0-9]+_floor=/ && $2 > 0 {found=1} END {print found+0}')
                        if [ "$HAS_FLOOR" = 1 ]; then RUNTIME=active; else RUNTIME=pending; fi
                    elif [ "$MODE" = auto ] && [ "$RUNTIME" = idle ]; then
                        RUNTIME=warming
                    else
                        RUNTIME=pending
                    fi
                    ;;
                thermal) RUNTIME=cooling ;;
                '') RUNTIME=inactive ;;
            esac
        fi
    fi
    "$BB" flock -u 9
    CPU_TEMP=未读取
    BATTERY_TEMP=未读取
    if find_sensors; then
        CPU_TEMP=$(max_temperature $CPU_ZONES | awk '{printf "%.1f°C", $1 / 1000}') || CPU_TEMP=未读取
        BATTERY_TEMP=$(max_temperature $BATTERY_ZONES | awk '{printf "%.1f°C", $1 / 1000}') || BATTERY_TEMP=未读取
        [ -n "$CPU_TEMP" ] || CPU_TEMP=未读取
        [ -n "$BATTERY_TEMP" ] || BATTERY_TEMP=未读取
    fi
    printf 'system_version=%s\nandroid_version=%s\nkernel=%s\ntarget_kernel=%s\n' \
        "$(getprop ro.system.build.version.incremental)" "$(getprop ro.build.version.release)" \
        "$CURRENT_KERNEL" "$TARGET_KERNEL"
    printf 'module_version=%s\nkernel_compatible=%s\nmode=%s\nruntime_mode=%s\n' \
        "$(sed -n 's/^version=//p' "$MODDIR/module.prop")" "$COMPATIBLE" "$MODE" "$RUNTIME"
    printf 'cpu_temperature=%s\nbattery_temperature=%s\n' "$CPU_TEMP" "$BATTERY_TEMP"
}

install_exporter() (
    INSTALL_DIR=$("$BB" mktemp -d /data/local/tmp/bkk-exporter.XXXXXX) || die '无法暂存日志保存组件'
    trap 'rm -rf "$INSTALL_DIR"' EXIT
    cp "$MODDIR/bin/bkk-log-exporter.apk" "$INSTALL_DIR/exporter.apk"
    chmod 0755 "$INSTALL_DIR"
    chmod 0644 "$INSTALL_DIR/exporter.apk"
    restorecon -RF "$INSTALL_DIR" >/dev/null 2>&1 || true
    pm install -r --user 0 "$INSTALL_DIR/exporter.apk" >&2 || die '日志保存组件安装失败'
)

resolve_exporter() {
    EXPORT_PACKAGE=org.bkkernel.logexport
    if ! pm path "$EXPORT_PACKAGE" >/dev/null 2>&1; then
        install_exporter
    fi
    EXPORT_INFO=$(dumpsys package "$EXPORT_PACKAGE") || die '无法读取日志保存组件'
    EXPORT_UID=$(printf '%s\n' "$EXPORT_INFO" | awk -F= '/^[[:space:]]*(userId|appId)=/{sub(/[[:space:]].*/, "", $2); print $2; exit}')
    EXPORT_DATA=$(printf '%s\n' "$EXPORT_INFO" | awk -F= '/^[[:space:]]*dataDir=/{sub(/[[:space:]].*/, "", $2); print $2; exit}')
    case "$EXPORT_UID" in ''|*[!0-9]*) die '日志保存组件UID无效' ;; esac
    case "$EXPORT_DATA" in
        /data/user/0/org.bkkernel.logexport|/data/data/org.bkkernel.logexport) ;;
        *) die '日志保存目录无效' ;;
    esac
    [ -d "$EXPORT_DATA" ] || die '日志保存目录不存在'
    EXPORT_DIR=$EXPORT_DATA/files
}

valid_log_name() {
    printf '%s\n' "$1" | "$BB" grep -Eq '^bkk-control-[0-9]{8}-[0-9]{6}-[0-9]+\.tar\.gz$'
}

collect_log() {
    resolve_exporter
    EXPORT_NAME=bkk-control-$(date '+%Y%m%d-%H%M%S')-$$.tar.gz
    WORK=$("$BB" mktemp -d "$STATE/.export.XXXXXX") || die '无法创建日志临时目录'
    EXPORT_TMP=$EXPORT_DIR/.$EXPORT_NAME.tmp
    # 导出只在点击时执行，临时文件始终归本次调用所有
    trap 'rm -f "$EXPORT_TMP"; rm -rf "$WORK"' EXIT
    mkdir -p "$EXPORT_DIR"
    chmod 0700 "$EXPORT_DIR"
    chown "$EXPORT_UID:$EXPORT_UID" "$EXPORT_DIR"
    get_all > "$WORK/overview.txt"
    uname -a >> "$WORK/overview.txt"
    for SOURCE in "$CONFIG" "$LOG" "$LOG.1" "$MODDIR/build-info.txt" "$MODDIR/module.prop" "$STATUS"; do
        [ ! -r "$SOURCE" ] || cp "$SOURCE" "$WORK/$(basename "$SOURCE")"
    done
    cat /proc/meminfo > "$WORK/meminfo.txt"
    dmesg | tail -n 1500 > "$WORK/dmesg.txt" || true
    "$BB" tar -czf "$EXPORT_TMP" -C "$WORK" . || die '日志打包失败'
    chown "$EXPORT_UID:$EXPORT_UID" "$EXPORT_TMP"
    chmod 0600 "$EXPORT_TMP"
    mv "$EXPORT_TMP" "$EXPORT_DIR/$EXPORT_NAME"
    restorecon -RF "$EXPORT_DIR" >/dev/null 2>&1 || true
    EXPORT_CONTEXT=$(ls -Zd "$EXPORT_DATA" | awk '{print $1; exit}')
    if [ -n "$EXPORT_CONTEXT" ]; then
        chcon "$EXPORT_CONTEXT" "$EXPORT_DIR" "$EXPORT_DIR/$EXPORT_NAME" >/dev/null 2>&1 || true
    fi
    printf 'name=%s\npath=%s/%s\n' "$EXPORT_NAME" "$EXPORT_DIR" "$EXPORT_NAME"
}

theme_seed() {
    SEED=$(cmd overlay lookup android android:color/system_accent1_500 2>/dev/null | tail -n 1)
    if printf '%s\n' "$SEED" | "$BB" grep -Eq '^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$'; then
        printf '%s\n' "$SEED"
    else
        printf '#6750a4\n'
    fi
}

[ "$(id -u)" = 0 ] || die '需要root'
[ -x "$BB" ] || die 'KernelSU BusyBox不存在'
# 系统shell会关闭传给flock的描述符，锁操作统一由BusyBox shell执行
if [ "${BKK_BUSYBOX_SHELL:-0}" != 1 ]; then
    BKK_BUSYBOX_SHELL=1 exec "$BB" sh "$0" "$@"
fi
unset BKK_BUSYBOX_SHELL
mkdir -p "$STATE"
chmod 0700 "$STATE"
exec 9>"$STATE/control.lock"
case "${1:-status}" in
    retain)
        case "${2:-status}" in apply|restore|status) ;; *) die '用法：bkctl retain apply|restore|status' ;; esac
        exec "$MODDIR/retention.sh" "${2:-status}"
        ;;
    memory)
        case "${2:-status}" in status|enable|disable) ;; *) die '用法：bkctl memory status|enable|disable' ;; esac
        [ -x "$MODDIR/zsmalloc/load.sh" ] || die '未安装配套分配器，需要与新内核一起构建'
        exec "$MODDIR/zsmalloc/load.sh" "${2:-status}"
        ;;
    get-all) get_all ;;
    theme-seed) theme_seed ;;
    collect-log) collect_log ;;
    open-log|cleanup-log)
        [ "$#" = 2 ] && valid_log_name "$2" || die '日志文件名无效'
        resolve_exporter
        if [ "$1" = cleanup-log ]; then
            rm -f "$EXPORT_DIR/$2"
        else
            [ -f "$EXPORT_DIR/$2" ] || die '日志文件不存在'
            am start --user 0 -n "$EXPORT_PACKAGE/.ExportActivity" \
                -f 0x10000000 --es name "$2" >/dev/null || die '无法打开日志保存窗口'
            echo '请选择日志保存位置'
        fi
        ;;
    daemon) daemon ;;
    set)
        [ "$#" = 3 ] && [ "$2" = mode ] || die '用法：bkctl set mode disabled|auto|manual'
        case "$3" in disabled|auto|manual) ;; *) die '模式无效' ;; esac
        "$BB" flock 9
        if [ "$3" = disabled ]; then
            set_mode disabled
            off
        else
            ensure_lkm
            set_mode "$3"
        fi
        log "mode=$3"
        "$BB" flock -u 9
        [ "$3" = disabled ] || start_daemon
        ;;
    restore)
        "$BB" flock 9
        set_mode disabled
        off
        log 'mode=disabled - restored'
        ;;
    boot)
        "$BB" flock 9
        read_mode
        if [ "$MODE" = disabled ]; then
            off
        else
            ensure_lkm
        fi
        "$BB" flock -u 9
        [ "$MODE" = disabled ] || start_daemon
        ;;
    status)
        read_mode
        printf 'configured_mode=%s\nkernel=%s\n' "$MODE" "$(uname -r)"
        sed -n '/^version=/p' "$MODDIR/module.prop"
        if [ -r "$STATUS" ]; then cat "$STATUS"; else printf 'state=unloaded\n'; fi
        ;;
    log) tail -n 150 "$LOG" 2>/dev/null || true ;;
    *) die '用法：bkctl status|get-all|set mode disabled/auto/manual|restore|log|collect-log|open-log NAME|cleanup-log NAME|theme-seed' ;;
esac
